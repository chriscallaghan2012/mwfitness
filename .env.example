# MW Fitness website — shared Neon backend
VITE_NEON_AUTH_URL="https://ep-aged-bread-zaqft12y.neonauth.c-2.eu-west-2.aws.neon.tech/mwfitness/auth"
VITE_NEON_DATA_API_URL="https://ep-aged-bread-zaqft12y.apirest.c-2.eu-west-2.aws.neon.tech/mwfitness/rest/v1"
# Server-only pooled PostgreSQL connection. Never expose with a VITE_ prefix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mwfitness?sslmode=require"

# Resend email suite (preferred sender; use a verified domain/sender)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="MW Fitness UK <no-reply@mwfitnessuk.com>"

# Contact form email backend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_GMAIL_ADDRESS@gmail.com"
SMTP_PASS="YOUR_16_CHAR_APP_PASSWORD"
MAIL_TO="mwfitnessukonline@gmail.com"
MAIL_FROM="MWFitnessUK <YOUR_GMAIL_ADDRESS@gmail.com>"
PUBLIC_SITE_URL="https://mwfitnessuk.com"

# Embedded Stripe Checkout + Staff HQ coaching-plan sync.
# Neon public.plans stores the current Stripe Product/Price IDs; do not add per-plan STRIPE_PRICE_* variables.
# For local/Preview development use matching Stripe test-mode keys and a NON-PRODUCTION Neon database.
# Staff HQ plan sync is production-only by default. Only after isolating Preview's Neon Auth, Data API and DATABASE_URL, set these flags on Preview only with matching Stripe test keys.
# STRIPE_PLAN_SYNC_PREVIEW_ENABLED="true"
# STRIPE_PLAN_SYNC_PREVIEW_DATABASE_ISOLATED="true"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_LOCALLY"
STRIPE_SECRET_KEY="sk_test_REPLACE_LOCALLY"
# Add the matching endpoint signing secret only when testing the webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_MATCHING_ENDPOINT_SECRET"
# Keep false until the payment-ledger migration, webhook endpoint and membership lifecycle are reviewed/tested.
STRIPE_PAYMENT_LEDGER_ENABLED="false"
# Required before enabling signed marketing-email unsubscribe links. Use a long random server-only secret.
COMMUNICATIONS_UNSUBSCRIBE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# AI Studio runtime (auto-injected — do not edit)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# MW Fitness website — shared Neon backend
VITE_NEON_AUTH_URL="https://ep-aged-bread-zaqft12y.neonauth.c-2.eu-west-2.aws.neon.tech/mwfitness/auth"
VITE_NEON_DATA_API_URL="https://ep-aged-bread-zaqft12y.apirest.c-2.eu-west-2.aws.neon.tech/mwfitness/rest/v1"
# Server-only pooled PostgreSQL connection. Never expose with a VITE_ prefix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mwfitness?sslmode=require"

# Resend email suite (preferred sender; use a verified domain/sender)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="MW Fitness UK <no-reply@mwfitnessuk.com>"

# Contact form email backend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_GMAIL_ADDRESS@gmail.com"
SMTP_PASS="YOUR_16_CHAR_APP_PASSWORD"
MAIL_TO="mwfitnessukonline@gmail.com"
MAIL_FROM="MWFitnessUK <YOUR_GMAIL_ADDRESS@gmail.com>"
PUBLIC_SITE_URL="https://mwfitnessuk.com"

# Embedded Stripe Checkout. The publishable key is public; the secret key and Price IDs stay server-side.
# Production requires matching live keys/prices and fails closed if they are missing.
# Preview/Development require test keys/prices when Stripe is configured; if both keys are absent, checkout uses an explicit mock simulation (no payment or membership activation). Partial or wrong-mode key configuration fails closed.
VITE_STRIPE_PUBLISHABLE_KEY="REPLACE_WITH_STRIPE_TEST_PUBLISHABLE_KEY_LOCALLY_OR_LIVE_PUBLISHABLE_KEY_IN_PRODUCTION"
STRIPE_SECRET_KEY="REPLACE_WITH_STRIPE_TEST_SECRET_KEY_LOCALLY_OR_LIVE_SECRET_IN_PRODUCTION"
# Keep false/absent until the payment-ledger migration is reviewed/applied and webhook tests pass.
STRIPE_PAYMENT_LEDGER_ENABLED="false"
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_MATCHING_STRIPE_WEBHOOK_SIGNING_SECRET"
STRIPE_PRICE_ONLINE_WEEKLY="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_12_WEEK="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_4_WEEK_ONCE="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_BRONZE_4WEEK="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_SILVER_8WEEK="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_GOLD_8WEEK="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
STRIPE_PRICE_ONLINE_PLATINUM_8WEEK="price_REPLACE_WITH_MATCHING_MODE_PRICE_ID"
# Required before enabling signed marketing-email unsubscribe links. Use a long random server-only secret.
COMMUNICATIONS_UNSUBSCRIBE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# AI Studio runtime (auto-injected — do not edit)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

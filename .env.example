# MW Fitness website — shared Neon backend
VITE_NEON_AUTH_URL="https://ep-aged-bread-zaqft12y.neonauth.c-2.eu-west-2.aws.neon.tech/mwfitness/auth"
VITE_NEON_DATA_API_URL="https://ep-aged-bread-zaqft12y.apirest.c-2.eu-west-2.aws.neon.tech/mwfitness/rest/v1"
# Server-only pooled PostgreSQL connection. Never expose with a VITE_ prefix.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/mwfitness?sslmode=require"

# Contact form email backend
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_GMAIL_ADDRESS@gmail.com"
SMTP_PASS="YOUR_16_CHAR_APP_PASSWORD"
MAIL_TO="mwfitnessukonline@gmail.com"
MAIL_FROM="MWFitnessUK <YOUR_GMAIL_ADDRESS@gmail.com>"
PUBLIC_SITE_URL="https://mwfitness.co.uk"
# Required before enabling signed marketing-email unsubscribe links. Use a long random server-only secret.
COMMUNICATIONS_UNSUBSCRIBE_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# AI Studio runtime (auto-injected — do not edit)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ============================================================
# MWFitnessUK — contact form / email backend
# The site POSTs contact enquiries to /api/send-mail, which sends
# them to MAIL_TO using these SMTP details (Nodemailer).
# ============================================================

# Gmail is easiest: use your own Gmail address + an "App Password"
# (Google Account → Security → 2-Step Verification → App passwords).
# SMTP_USER is also the FROM address on the emails Mike receives.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="YOUR_GMAIL_ADDRESS@gmail.com"
SMTP_PASS="YOUR_16_CHAR_APP_PASSWORD"

# Where the enquiries are delivered (defaults to mikeptonline@gmail.com).
MAIL_TO="mikeptonline@gmail.com"

# ============================================================
# AI Studio runtime (auto-injected — do not edit)
# ============================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://christopherjcallaghan.com https://www.christopherjcallaghan.com" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/stripe-webhook", "destination": "/api/create-checkout?route=webhook" },
    { "source": "/api/checkout-status", "destination": "/api/create-checkout?route=status" },
    { "source": "/online-coaching", "destination": "/index.html" },
    { "source": "/nutrition", "destination": "/index.html" },
    { "source": "/reviews", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/shwag", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/cookies", "destination": "/index.html" },
    { "source": "/gdpr", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/delete-account", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/packages", "destination": "/online-coaching", "permanent": true }
  ]
}